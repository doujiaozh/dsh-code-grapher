# ===== Intern InkStone (OpenAI-compatible) =====
# Base URL of the Intern InkStone discovery API (OpenAI-compatible /v1 endpoint).
INKSTONE_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
# API key. On DSH hosts this is already stored in ~/.dsh/.credentials.yaml
# and exported by the harness; otherwise request one from the InkStone console.
INKSTONE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model used for semantic file analysis.
INKSTONE_MODEL=deepseek-v4.1-flash-1017

# ===== Rate limiting =====
# InkStone free tier caps requests at 50 RPM. The limiter is a sliding-window
# guard ON TOP of --rpm so you can always go lower, never higher.
CG_RPM=45

# ===== Concurrency =====
# Parallel LLM "crew" workers (each pulls batches off the queue).
CG_WORKERS=4
# Files analyzed per single LLM request (batching cuts request count ~N-fold).
CG_BATCH_SIZE=6

# ===== Completion token budget =====
# max_tokens sent per LLM request. Free InkStone channels may reject large
# budgets with HTTP 429 "Channel rate limit reached for model" (observed:
# >= 200 refused). Keep low on free tiers; raise for paid channels.
CG_MAX_TOKENS=180

# Source context chars per file sent to the LLM (drives prompt size).
# CG_CONTEXT_CHARS=4000
